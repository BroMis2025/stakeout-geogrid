# Copy into your cloud environment. Never commit populated settings.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Default neon. Use tcp only for plain PostgreSQL or an isolated local test.
DB_TRANSPORT=neon
AUTH_SECRET=
REDIS_URL=
DUOPLUS_API_KEY=
# API Tools connection credentials for login-based GEO/session targeting.
PROXY_SELLER_BASE_LOGIN=
PROXY_SELLER_PASSWORD=
# Optional: used only by npm run proxy:check; never a NEXT_PUBLIC variable.
PROXY_SELLER_API_KEY=
# Detailed docs say resident/lists; overview says proxy/lists. Explicit override.
PROXY_SELLER_LISTS_PATH=resident/lists
PROXY_SELLER_HOST=us.res.proxy-seller.com
PROXY_PORT=10000
# Set true on web AND worker for parallel fleet ports: 10000 + slotIndex.
# Provider range: 10000-10999. Slots start at 1; slot mode supports 1-999.
PROXY_USE_SLOT_PORT=false
# Provider-issued numeric IDs; map the wizard's ISP code and state abbreviation.
PROXY_ISP_IDS_JSON={}
PROXY_STATE_IDS_JSON={}
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stakeout-artifacts
MOBILE_CONCURRENCY=5
# Opt-in only after verifying detach/rebind on a dedicated staging image.
UNBIND_PROXY_BEFORE_UPLOAD=false
TEASER_DAILY_LIMIT=25
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Prices in USD cents. Only packs with a positive configured price can be sold.
PAYPAL_PACK_500_USD_CENTS=
PAYPAL_PACK_750_USD_CENTS=
PAYPAL_PACK_3000_USD_CENTS=
PAYPAL_PACK_7500_USD_CENTS=
# Optional desktop runtime, enable in web and worker only after configuring it.
NEXT_PUBLIC_DESKTOP_ENABLED=false
DESKTOP_ENABLED=false
DESKTOP_PROXY_URL=
DESKTOP_ANSWER_SELECTOR=
# Optional licensed MapLibre style URL
NEXT_PUBLIC_MAP_STYLE_URL=
# Deployment script inputs, set the target explicitly.
NEON_ORG_ID=
NEON_PROJECT_ID=
NEON_BRANCH=
